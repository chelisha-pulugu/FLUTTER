import 'package:flutter/material.dart';

void main() {
  runApp(MyApp());
}

class MyApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    double width = MediaQuery.of(context).size.width;

    return MaterialApp(
      debugShowCheckedModeBanner: true,
      home: Scaffold(
        appBar: AppBar(
          title: Text("Responsive UI"),

          // Desktop / Large Screen
          actions: width >= 600
              ? [
                  TextButton(
                    onPressed: () {},
                    child: Text(
                      "Home",
                      style: TextStyle(color: Colors.black),
                    ),
                  ),
                  TextButton(
                    onPressed: () {},
                    child: Text(
                      "About",
                      style: TextStyle(color: Colors.black),
                    ),
                  ),
                  TextButton(
                    onPressed: () {},
                    child: Text(
                      "Service",
                      style: TextStyle(color: Colors.black),
                    ),
                  ),
                  TextButton(
                    onPressed: () {},
                    child: Text(
                      "Contact",
                      style: TextStyle(color: Colors.black),
                    ),
                  ),
                ]

              // Mobile Screen - 3 dot menu
              : [
                  PopupMenuButton<String>(
                    icon: Icon(
                      Icons.more_vert,
                      color: Colors.black,
                    ),
                    onSelected: (value) {
                      if (value == "Home") {
                        print("Home clicked");
                      } else if (value == "About") {
                        print("About clicked");
                      } else if (value == "Service") {
                        print("Service clicked");
                      } else if (value == "Contact") {
                        print("Contact clicked");
                      }
                    },
                    itemBuilder: (BuildContext context) {
                      return [
                        PopupMenuItem(
                          value: "Home",
                          child: Text("Home"),
                        ),
                        PopupMenuItem(
                          value: "About",
                          child: Text("About"),
                        ),
                        PopupMenuItem(
                          value: "Service",
                          child: Text("Service"),
                        ),
                        PopupMenuItem(
                          value: "Contact",
                          child: Text("Contact"),
                        ),
                      ];
                    },
                  ),
                ],
        ),
        body: Container(
          width: double.infinity,
          height: double.infinity,
          decoration: BoxDecoration(
            image: DecorationImage(
              image: AssetImage("assets/images/background.jpg"),
              fit: BoxFit.cover,
            ),
          ),
          child: Center(
            child: width < 600
                ? Text(
                    "Mobile Screen",
                    style: TextStyle(
                      fontSize: 25,
                      color: Colors.white,
                    ),
                  )
                : Text(
                    "Large Screen",
                    style: TextStyle(
                      fontSize: 25,
                      color: Colors.white,
                    ),
                  ),
          ),
        ),
      ),
    );
  }
}
